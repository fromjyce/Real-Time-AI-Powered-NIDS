# ─── Kafka ───────────────────────────────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_RAW_PACKETS=raw_packets
KAFKA_TOPIC_PROCESSED_FEATURES=processed_features
KAFKA_TOPIC_ALERTS=alerts
KAFKA_GROUP_ID=nids-processor
KAFKA_AUTO_OFFSET_RESET=latest
KAFKA_MAX_POLL_INTERVAL_MS=300000

# ─── Elasticsearch ───────────────────────────────────────────────────────────
ELASTICSEARCH_HOST=http://localhost:9200
ELASTICSEARCH_INDEX_ALERTS=nids-alerts
ELASTICSEARCH_INDEX_FLOWS=nids-flows
ELASTICSEARCH_INDEX_PROFILES=nids-profiles

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
REDIS_CACHE_TTL=3600
REDIS_PROFILE_TTL=86400

# ─── Model Paths ─────────────────────────────────────────────────────────────
MODEL_PATH=./models
SEQUENCE_MODEL_PATH=./models/cnn_gru.pt
TRANSFORMER_MODEL_PATH=./models/transformer.pt
ANOMALY_MODEL_PATH=./models/isolation_forest.joblib
AUTOENCODER_PATH=./models/autoencoder.pt

# ─── Fusion Weights ──────────────────────────────────────────────────────────
FUSION_WEIGHT_ML=0.50
FUSION_WEIGHT_ANOMALY=0.30
FUSION_WEIGHT_SIGNATURE=0.20

# ─── Decision Thresholds ─────────────────────────────────────────────────────
THRESHOLD_SUSPICIOUS=0.40
THRESHOLD_MALICIOUS=0.70

# ─── Packet Capture ──────────────────────────────────────────────────────────
CAPTURE_INTERFACE=eth0
CAPTURE_BPF_FILTER=ip
CAPTURE_SNAPSHOT_LEN=65535
CAPTURE_PROMISC=true

# ─── Alerting ────────────────────────────────────────────────────────────────
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token
SLACK_CHANNEL_ID=C0000000000
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=nids-alerts@yourcompany.com
SMTP_PASSWORD=your-app-password
ALERT_EMAIL_TO=security-team@yourcompany.com
WEBHOOK_URL=https://hooks.yourcompany.com/nids/alerts

# ─── Threat Intelligence ─────────────────────────────────────────────────────
ABUSEIPDB_API_KEY=your-abuseipdb-api-key
VIRUSTOTAL_API_KEY=your-virustotal-api-key
THREAT_FEED_UPDATE_INTERVAL=3600

# ─── API ─────────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
API_SECRET_KEY=change-this-to-a-secure-random-value-in-production
API_CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ─── Adaptive Learning ───────────────────────────────────────────────────────
DRIFT_DETECTION_WINDOW=1000
DRIFT_DETECTION_THRESHOLD=0.002
RETRAIN_INTERVAL_HOURS=24
MIN_SAMPLES_FOR_RETRAIN=5000

# ─── Observability ───────────────────────────────────────────────────────────
PROMETHEUS_PORT=8001
LOG_LEVEL=INFO
LOG_FORMAT=json
